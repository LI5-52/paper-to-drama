{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/paper-to-drama/project.schema.json",
  "title": "Paper-to-Drama staged project contract V0.1",
  "type": "object",
  "required": ["project_id", "paper", "research_cards", "seed", "core_question", "style_options", "selection", "story_bible", "screenplay", "assets", "shots", "model_prompts", "qa_log", "production"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "paper": {"type": "object", "required": ["title", "source", "evidence_ids"], "properties": {"title": {"type": "string"}, "source": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}},
    "research_cards": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "claim_type", "source_locator", "interest_angle"], "properties": {"id": {"type": "string"}, "claim_type": {"enum": ["supported_claim", "source_question_or_hypothesis", "interpretive_bridge", "fictional_plot"]}, "evidence_id": {"type": "string"}, "source_locator": {"type": "string"}, "interest_angle": {"type": "string"}, "uncertainty": {"type": "string"}}}},
    "seed": {"type": "object", "required": ["id", "research_card_ids", "core_question_id", "character_goal", "obstacle", "choice"], "properties": {"id": {"type": "string"}, "research_card_ids": {"type": "array", "items": {"type": "string"}}, "core_question_id": {"type": "string"}, "character_goal": {"type": "string"}, "obstacle": {"type": "string"}, "choice": {"type": "string"}}},
    "core_question": {"type": "object", "required": ["id", "question"], "properties": {"id": {"type": "string"}, "question": {"type": "string"}}},
    "style_options": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["id", "core_question_id", "world", "genre", "dramatic_engine", "visual_mode", "hook", "premise", "why_fit"], "properties": {"id": {"type": "string"}, "core_question_id": {"type": "string"}, "world": {"type": "string"}, "genre": {"type": "string"}, "dramatic_engine": {"type": "string"}, "visual_mode": {"type": "string"}, "hook": {"type": "string"}, "premise": {"type": "string"}, "why_fit": {"type": "string"}}}},
    "selection": {"type": "object", "required": ["selected_style_id"], "properties": {"selected_style_id": {"type": "string"}}},
    "story_bible": {"type": "object", "required": ["selected_style_id", "logline", "beats"], "properties": {"selected_style_id": {"type": "string"}, "logline": {"type": "string"}, "beats": {"type": "array", "items": {"type": "object", "required": ["id", "action", "consequence", "knowledge_state"], "properties": {"id": {"type": "string"}, "action": {"type": "string"}, "consequence": {"type": "string"}, "knowledge_state": {"type": "string"}}}}}},
    "screenplay": {"type": "object", "required": ["scenes"], "properties": {"scenes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "location_id", "character_ids", "what_changes", "action", "dialogue"], "properties": {"id": {"type": "string"}, "location_id": {"type": "string"}, "character_ids": {"type": "array", "items": {"type": "string"}}, "what_changes": {"type": "string"}, "action": {"type": "string"}, "dialogue": {"type": "array", "items": {"type": "object", "required": ["speaker_id", "line"], "properties": {"speaker_id": {"type": "string"}, "line": {"type": "string"}}}}}}}}},
    "assets": {"type": "object", "required": ["characters", "locations"], "properties": {"characters": {"type": "array", "items": {"type": "object", "required": ["id", "look", "voice"], "properties": {"id": {"type": "string"}, "look": {"type": "string"}, "voice": {"type": "string"}}}}, "locations": {"type": "array", "items": {"type": "object", "required": ["id", "description"], "properties": {"id": {"type": "string"}, "description": {"type": "string"}}}}}},
    "shots": {"type": "array", "items": {"type": "object", "required": ["id", "scene_id", "location_id", "character_ids", "purpose", "start_state", "visible_action", "end_state", "duration_s"], "properties": {"id": {"type": "string"}, "scene_id": {"type": "string"}, "location_id": {"type": "string"}, "character_ids": {"type": "array", "items": {"type": "string"}}, "purpose": {"type": "string"}, "start_state": {"type": "string"}, "visible_action": {"type": "string"}, "end_state": {"type": "string"}, "duration_s": {"type": "number", "exclusiveMinimum": 0}, "camera": {"type": "string"}}}},
    "model_prompts": {"type": "array", "items": {"type": "object", "required": ["shot_id", "platform", "prompt"], "properties": {"shot_id": {"type": "string"}, "platform": {"type": "string"}, "prompt": {"type": "string"}}}},
    "qa_log": {"type": "array", "items": {"type": "object", "required": ["stage", "target_id", "issue_type", "severity"], "properties": {"stage": {"type": "string"}, "target_id": {"type": "string"}, "issue_type": {"type": "string"}, "severity": {"enum": ["blocker", "major", "minor", "preference"]}}}},
    "production": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["not_started", "planned", "submitted", "generating", "failed", "video_ready"]}, "verified_result_uri": {"type": "string"}}}
  }
}
